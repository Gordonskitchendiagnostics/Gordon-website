# Gordon's Kitchen Diagnostics - canonical URL rules
RewriteEngine On

# Retired duplicate routes from previous site versions.
# These must redirect instead of being served by the SPA fallback.
RewriteRule ^home/?$ https://gordonsservice.com/ [R=301,L,NE]
RewriteRule ^privacy-policy/?$ https://gordonsservice.com/ [R=301,L,NE]
RewriteRule ^terms-and-conditions/?$ https://gordonsservice.com/ [R=301,L,NE]

# Force one canonical origin: HTTPS + non-WWW.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.gordonsservice\.com$ [NC]
RewriteRule ^ https://gordonsservice.com%{REQUEST_URI} [R=301,L,NE]

# Vite/Vue SPA fallback.
# Existing files/directories are served normally; unknown client routes load the app.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
